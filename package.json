{
  "name": "quroots",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "NODE_OPTIONS='--dns-result-order=ipv4first' next dev",
    "dev:clean": "rm -rf .next && NODE_OPTIONS='--dns-result-order=ipv4first' next dev",
    "build": "NODE_OPTIONS='--dns-result-order=ipv4first' next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "migrate-db": "node scripts/migrate-to-db.mjs",
    "generate-data": "node scripts/generate-data.mjs",
    "watch-data": "node scripts/watch-data.mjs",
    "populate:surahs": "node scripts/populate-surahs.mjs",
    "populate:ayahs": "node scripts/populate-ayahs.mjs",
    "populate:translations": "node scripts/populate-translations.mjs",
    "populate:words": "node scripts/populate-words.mjs",
    "populate:all": "node scripts/populate-surahs.mjs && node scripts/populate-ayahs.mjs && node scripts/populate-translations.mjs && node scripts/populate-words.mjs",
    "populate:roots-backfill": "node scripts/backfill-word-roots.mjs",
    "check:hifz": "node --experimental-strip-types scripts/check-hifz.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.1",
    "@floating-ui/react": "^0.27.19",
    "@tailwindcss/postcss": "^4.2.2",
    "autoprefixer": "^10.4.27",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "framer-motion": "^12.38.0",
    "isomorphic-dompurify": "^3.7.1",
    "next": "^14.2.35",
    "next-auth": "^5.0.0-beta.30",
    "postcss": "^8.5.8",
    "postgres": "^3.4.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "zod": "^4.3.6",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.12",
    "globals": "^16.5.0",
    "playwright-core": "^1.62.0",
    "typescript": "^5.9.3"
  }
}
